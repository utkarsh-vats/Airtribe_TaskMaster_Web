# Browser-side base URL of the TaskMaster API
NEXT_PUBLIC_API_URL=http://localhost:3000
# Server-side base URL used by route handlers (may differ from the public one in Docker)
API_URL=http://localhost:3000
# OpenAPI spec used by `npm run api:types` (step 3)
API_SPEC_URL=http://localhost:3000/openapi.json
# Lifetime of the tm_refresh cookie in days — keep equal to the backend's REFRESH_TOKEN_TTL_DAYS
REFRESH_COOKIE_MAX_AGE_DAYS=7
# Public origin of this app, only needed when a proxy rewrites the Host (auth Origin check)
# APP_ORIGIN=https://tasks.example.com
